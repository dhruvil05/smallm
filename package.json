{
  "name": "smallm",
  "version": "0.5.0",
  "description": "Find the right small language model (SLM) for a task, based on given context. Live rule-based matching against the HuggingFace API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "smallm": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"try { require('fs').chmodSync('dist/cli.js', 0o755); } catch (e) {}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "llm",
    "slm",
    "small-language-model",
    "huggingface",
    "model-selection",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
